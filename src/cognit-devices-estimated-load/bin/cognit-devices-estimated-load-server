if [ -z "$ONE_LOCATION" ]; then
    COGNIT_ESTLOAD_PID=/var/run/one/cognit-devices-estimated-load.pid
    COGNIT_ESTLOAD_SERVER=/usr/lib/one/cognit-devices-estimated-load/src/main.py
    COGNIT_ESTLOAD_LOCK_FILE=/var/lock/one/.cognit-devices-estimated-load.lock
    COGNIT_ESTLOAD_LOG=/var/log/one/cognit-devices-estimated-load.log
    COGNIT_ESTLOAD_LOG_ERROR=/var/log/one/cognit-devices-estimated-load.error
    COGNIT_ESTLOAD_CONF=/etc/one/cognit-devices-estimated-load.conf
    COGNIT_ESTLOAD_VENV=/usr/share/one/cognit-frontend/python-venv
else
    COGNIT_ESTLOAD_PID=$ONE_LOCATION/var/cognit-devices-estimated-load.pid
    COGNIT_ESTLOAD_SERVER=$ONE_LOCATION/lib/cognit-devices-estimated-load/src/main.py
    COGNIT_ESTLOAD_LOCK_FILE=$ONE_LOCATION/var/.cognit-devices-estimated-load.lock
    COGNIT_ESTLOAD_LOG=$ONE_LOCATION/var/cognit-devices-estimated-load.log
    COGNIT_ESTLOAD_LOG_ERROR=$ONE_LOCATION/var/cognit-devices-estimated-load.error
    COGNIT_ESTLOAD_CONF=$ONE_LOCATION/etc/cognit-devices-estimated-load.conf
    COGNIT_ESTLOAD_VENV=$ONE_LOCATION/share/cognit-venv
fi

if [ -z "$ONE_LOCATION" ]; then
    export PYTHONPATH="/var/lib/one/remotes/im/lib/python${PYTHONPATH:+:$PYTHONPATH}"
else
    export PYTHONPATH="$ONE_LOCATION/var/remotes/im/lib/python${PYTHONPATH:+:$PYTHONPATH}"
fi

setup()
{
  if [ -f $COGNIT_ESTLOAD_LOCK_FILE ]; then
    if [ -f  $COGNIT_ESTLOAD_PID ]; then
      COGNITESTLOADPID=`cat $COGNIT_ESTLOAD_PID`
      ps $COGNITESTLOADPID &> /dev/null
      if [ $? -eq 0 ]; then
        echo -n "Cognit Devices Estimated Load is still running (PID:$COGNITESTLOADPID). Please "
        echo "try 'cognit-devices-estimated-load-server stop' first."
        exit 1
      fi
    fi
    echo "Stale .lock detected. Erasing it."
    rm $COGNIT_ESTLOAD_LOCK_FILE
  fi
}


start()
{
  if [ ! -f "$COGNIT_ESTLOAD_SERVER" ]; then
    echo "Cannot find $COGNIT_ESTLOAD_SERVER."
    exit 1
  fi

  # Activate virtual environment if it exists (uses cognit-frontend's venv)
  if [ -d "$COGNIT_ESTLOAD_VENV" ]; then
    source $COGNIT_ESTLOAD_VENV/bin/activate
  fi

  # Start the cognit-devices-estimated-load daemon
  touch $COGNIT_ESTLOAD_LOCK_FILE
  python3 $COGNIT_ESTLOAD_SERVER --daemon --interval 30 >> $COGNIT_ESTLOAD_LOG 2>>$COGNIT_ESTLOAD_LOG_ERROR &
  LASTPID=$!

  if [ $? -ne 0 ]; then
    echo "Error executing cognit-devices-estimated-load-server."
    echo "Check $COGNIT_ESTLOAD_LOG_ERROR and $COGNIT_ESTLOAD_LOG for more information"
    exit 1
  else
    echo $LASTPID > $COGNIT_ESTLOAD_PID
  fi

  sleep 1
  ps $LASTPID &> /dev/null

  if [ $? -ne 0 ]; then
    echo "Error executing cognit-devices-estimated-load-server."
    echo "Check $COGNIT_ESTLOAD_LOG_ERROR and $COGNIT_ESTLOAD_LOG for more information"
    exit 1
  fi

  echo "cognit-devices-estimated-load-server started"
}

#
# Function that stops the daemon/service
#
stop()
{
  if [ ! -f $COGNIT_ESTLOAD_PID ]; then
    echo "Couldn't find cognit-devices-estimated-load-server process pid."
    exit 1
  fi

  # Kill the cognit-devices-estimated-load daemon
  kill -INT `cat $COGNIT_ESTLOAD_PID` &> /dev/null

  # Remove pid files
  rm -f $COGNIT_ESTLOAD_LOCK_FILE &> /dev/null
  rm -f $COGNIT_ESTLOAD_PID &> /dev/null

  echo "cognit-devices-estimated-load-server stopped"
}

case "$1" in
  start)
    setup
    start
    ;;
  stop)
    stop
    ;;
  restart)
    stop
    setup
    start
    ;;
  *)
    echo "Usage: cognit-devices-estimated-load-server {start|stop|restart}" >&2
    exit 3
    ;;
esac
