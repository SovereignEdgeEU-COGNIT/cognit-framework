if [ -z "$ONE_LOCATION" ]; then
    COGNIT_FRONTEND_PID=/var/run/one/cognit-frontend.pid
    COGNIT_FRONTEND_SERVER=/usr/lib/one/cognit-frontend/src/main.py
    COGNIT_FRONTEND_LOCK_FILE=/var/lock/one/.cognit-frontend.lock
    COGNIT_FRONTEND_LOG=/var/log/one/cognit-frontend.log
    COGNIT_FRONTEND_LOG_ERROR=/var/log/one/cognit-frontend.error
    COGNIT_FRONTEND_CONF=/etc/one/cognit-frontend.conf
    COGNIT_FRONTEND_VENV=/usr/share/one/cognit-frontend/python-venv
else
    COGNIT_FRONTEND_PID=$ONE_LOCATION/var/cognit-frontend.pid
    COGNIT_FRONTEND_SERVER=$ONE_LOCATION/lib/cognit-frontend/src/main.py
    COGNIT_FRONTEND_LOCK_FILE=$ONE_LOCATION/var/.cognit-frontend.lock
    COGNIT_FRONTEND_LOG=$ONE_LOCATION/var/cognit-frontend.log
    COGNIT_FRONTEND_LOG_ERROR=$ONE_LOCATION/var/cognit-frontend.error
    COGNIT_FRONTEND_CONF=$ONE_LOCATION/etc/cognit-frontend.conf
    COGNIT_FRONTEND_VENV=$ONE_LOCATION/share/cognit-frontend/python-venv
fi

setup()
{
  if [ -f $COGNIT_FRONTEND_LOCK_FILE ]; then
    if [ -f  $COGNIT_FRONTEND_PID ]; then
      COGNITFRONTENDPID=`cat $COGNIT_FRONTEND_PID`
      ps $COGNITFRONTENDPID &> /dev/null
      if [ $? -eq 0 ]; then
        echo -n "Cognit Frontend is still running (PID:$COGNITFRONTENDPID). Please "
        echo "try 'cognit-frontend-server stop' first."
        exit 1
      fi
    fi
    echo "Stale .lock detected. Erasing it."
    rm $COGNIT_FRONTEND_LOCK_FILE
  fi
}


start()
{
  if [ ! -f "$COGNIT_FRONTEND_SERVER" ]; then
    echo "Cannot find $COGNIT_FRONTEND_SERVER."
    exit 1
  fi

  # Activate virtual environment if it exists
  if [ -d "$COGNIT_FRONTEND_VENV" ]; then
    source $COGNIT_FRONTEND_VENV/bin/activate
  fi

  # Start the cognit-frontend daemon
  touch $COGNIT_FRONTEND_LOCK_FILE
  python3 $COGNIT_FRONTEND_SERVER >> $COGNIT_FRONTEND_LOG 2>>$COGNIT_FRONTEND_LOG_ERROR &
  LASTPID=$!

  if [ $? -ne 0 ]; then
    echo "Error executing cognit-frontend-server."
    echo "Check $COGNIT_FRONTEND_LOG_ERROR and $COGNIT_FRONTEND_LOG for more information"
    exit 1
  else
    echo $LASTPID > $COGNIT_FRONTEND_PID
  fi

  sleep 1
  ps $LASTPID &> /dev/null

  if [ $? -ne 0 ]; then
    echo "Error executing cognit-frontend-server."
    echo "Check $COGNIT_FRONTEND_LOG_ERROR and $COGNIT_FRONTEND_LOG for more information"
    exit 1
  fi

  echo "cognit-frontend-server started"
}

#
# Function that stops the daemon/service
#
stop()
{
  if [ ! -f $COGNIT_FRONTEND_PID ]; then
    echo "Couldn't find cognit-frontend-server process pid."
    exit 1
  fi

  # Kill the cognit-frontend daemon
  kill -INT `cat $COGNIT_FRONTEND_PID` &> /dev/null

  # Remove pid files
  rm -f $COGNIT_FRONTEND_LOCK_FILE &> /dev/null
  rm -f $COGNIT_FRONTEND_PID &> /dev/null

  echo "cognit-frontend-server stopped"
}

case "$1" in
  start)
    setup
    start
    ;;
  stop)
    stop
    ;;
  restart)
    stop
    setup
    start
    ;;
  *)
    echo "Usage: cognit-frontend-server {start|stop|restart}" >&2
    exit 3
    ;;
esac
